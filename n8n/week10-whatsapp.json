    {
      "parameters": {
        "jsCode": "// Junta o item da leva com o que a Meta respondeu, na mesma ordem.\nconst leva = $('Um por pessoa').all();\nreturn $input.all().map((r, i) => {\n  const j = r.json || {};\n  const id = leva[i].json.id;\n  const wamid = j.messages?.[0]?.id ?? null;\n  const e = j.error ?? null;\n  return { json: { id, wamid, erro: e ? (e.message || JSON.stringify(e)).slice(0, 300) : (wamid ? null : 'sem resposta'), codigo: e?.code ?? null } };\n});"
      },
