# === Checkatrade Express Bot Config ===

# Credenciais de login (your own Checkatrade partner account)
CREW_EMAIL=
CREW_PASSWORD=
CHECKATRADE_EMAIL=
CHECKATRADE_PASSWORD=

PORTAL_URL=https://membersapp.checkatrade.com/jobs/login
JOBS_URL=https://membersapp.checkatrade.com/jobs/business

# Poll interval in seconds + random jitter fraction (0.6 = up to +60%)
POLL_INTERVAL=30
POLL_JITTER=0.6

AUTO_ACCEPT=true
MAX_JOBS_PER_DAY=0

# === Filters (optional) ===
JOB_KEYWORDS=
MIN_JOB_VALUE=0
MIN_DATE_DAYS_AHEAD=0

# === Active window (UK time) ===
RUN_DAYS=0,1,2,3,4,5,6
RUN_START_HOUR=8
RUN_END_HOUR=20
RUN_TIMEZONE=Europe/London
JOB_SLOT_DAYS=0,1,2,3,4,5,6

# === Email Notifications (optional — leave EMAIL_ENABLED=false to skip) ===
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_TO=

# === Zendesk ticket creation on accept (optional) ===
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_PRIORITY=normal

# === Master OS webhook keys (same values as the main repo's .env.local) ===
MASTER_OS_JOB_WEBHOOK_API_KEY=
MASTER_OS_LEAD_WEBHOOK_API_KEY=
