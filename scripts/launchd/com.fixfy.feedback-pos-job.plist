<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Feedback pos-job: WhatsApp "como foi?" para o cliente de job pago.

  Instalar:
    cp scripts/launchd/com.fixfy.feedback-pos-job.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.fixfy.feedback-pos-job.plist

  Desligar:
    launchctl unload ~/Library/LaunchAgents/com.fixfy.feedback-pos-job.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fixfy.feedback-pos-job</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/victorsouza/master-os &amp;&amp; npx tsx scripts/feedback-pos-job.mts --enviar</string>
  </array>
  <!-- Duas horas locais (Mac em UTC-3): 06h local = 10h de Londres no verao,
       07h local = 10h no inverno. O guarda do script (9h-20h de Londres)
       filtra, e a trava por job em audit_logs impede pedido dobrado. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/victorsouza/master-os/.logs/feedback-pos-job.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/victorsouza/master-os/.logs/feedback-pos-job.log</string>
</dict>
</plist>
